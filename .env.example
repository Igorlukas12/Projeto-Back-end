# Servidor
PORT=3000
# URL pública usada para montar os links absolutos das imagens (opcional)
APP_URL=http://localhost:3000

# Banco de dados (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=projeto_backend

# Autenticação JWT
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=1h

# Pasta onde as imagens dos produtos são salvas
UPLOAD_DIR=uploads
